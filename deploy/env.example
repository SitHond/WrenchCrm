# Version of the WrenchCRM image. Change it and run `docker compose pull && docker compose up -d` to update.
WRENCH_VERSION=__VERSION__

# Generated by install.sh / install.ps1. Keep them secret and do not change after the first start.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=

# First administrator, created on the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

APP_PORT=3000
SHOP_NAME=Автосервис
SHOP_DETAILS=
CURRENCY_UNIT=₽
TIME_ZONE=Europe/Moscow
WORKDAY_START=9
WORKDAY_END=20

# Behind an HTTPS reverse proxy set both to true.
RAILS_ASSUME_SSL=false
RAILS_FORCE_SSL=false

# Encrypted backups (backup.sh). Keep the passphrase somewhere else too: without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# 1 = load demo clients, vehicles and orders on the first start.
SEED_DEMO=
