<%= page_header @client.display_name do %>
  <% if can?(:manage_orders) && @client.vehicles.any? %>
    <%= link_to t("work_orders.new"), new_work_order_path(vehicle_id: @client.vehicles.first.id), class: "btn btn-primary" %>
  <% end %>
  <%= link_to t("edit"), edit_client_path(@client), class: "btn" if can?(:manage_clients) %>
  <%= button_to t("delete"), @client, method: :delete, class: "btn btn-danger",
        form: { data: { turbo_confirm: t("confirm") } } if can?(:delete_records) %>
<% end %>

<% if @client.anonymized? %>
  <p class="flash flash-notice"><%= t("privacy.anonymized_banner", date: l(@client.anonymized_at, format: :short), user: @client.anonymized_by&.name || "—") %></p>
<% end %>

<p class="subtitle">
  <%= enum_label(Client, :kind, @client.kind) %>
  <% unless @client.active? %>· <span class="badge"><%= t("status.inactive") %></span><% end %>
</p>

<div class="grid-2">
  <section class="card">
    <h2><%= t("clients.sections.contacts") %></h2>
    <dl class="details">
      <%= detail_row Client.human_attribute_name(:phone), phone_link(@client.phone) %>
      <%= detail_row Client.human_attribute_name(:phone2), phone_link(@client.phone2) %>
      <%= detail_row Client.human_attribute_name(:email), (mail_to(@client.email) if @client.email.present?) %>
      <%= detail_row Client.human_attribute_name(:address), @client.address %>
      <%= detail_row Client.human_attribute_name(:inn), @client.inn %>
      <%= detail_row Client.human_attribute_name(:ad_source), @client.ad_source&.name %>
    </dl>
  </section>

  <section class="card">
    <h2><%= Client.human_attribute_name(:vehicles) %></h2>
    <% if @client.vehicles.any? %>
      <ul class="list">
        <% @client.vehicles.each do |vehicle| %>
          <li>
            <%= link_to vehicle.title, vehicle %>
            <% if vehicle.plate_number %><span class="plate"><%= vehicle.plate_number %></span><% end %>
            <% if can?(:manage_orders) %>
              <%= link_to t("work_orders.new_short"), new_work_order_path(vehicle_id: vehicle.id), class: "link-button" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted"><%= t("clients.no_vehicles") %></p>
    <% end %>
    <%= link_to t("vehicles.new"), new_vehicle_path(client_id: @client.id), class: "btn" if can?(:manage_clients) %>
  </section>
</div>

<section class="card" id="consents">
  <h2><%= t("consents.title") %></h2>
  <div class="consent-grid">
    <% Consent.kinds.each_key do |kind| %>
      <% current = @client.consent(kind) %>
      <div class="consent-box <%= current ? "ok-box" : "warn-box" %>">
        <div><strong><%= t("consents.kinds.#{kind}") %></strong></div>
        <% if current %>
          <div class="small"><%= t("consents.given", date: l(current.given_at, format: :short), channel: enum_label(Consent, :channel, current.channel), user: current.recorded_by&.name || "—") %></div>
          <div class="small muted"><%= t("consents.version", version: current.text_version) %></div>
        <% else %>
          <div class="small"><%= t("consents.missing.#{kind}") %></div>
        <% end %>
        <div class="consent-actions">
          <%= link_to t("consents.print"), print_client_consents_path(@client, kind: kind), class: "btn", target: "_blank" %>
          <% if can?(:manage_clients) %>
            <% if current %>
              <details class="dropdown">
                <summary class="btn btn-danger"><%= t("consents.withdraw") %> ▾</summary>
                <div class="dropdown-menu wide">
                  <%= form_with url: withdraw_client_consent_path(@client, current), method: :patch, class: "inline-form compact pad" do |form| %>
                    <%= form.text_field :reason, required: true, placeholder: t("consents.reason_placeholder"), aria: { label: t("consents.reason_placeholder") } %>
                    <%= form.submit t("consents.withdraw"), class: "btn btn-danger" %>
                  <% end %>
                </div>
              </details>
            <% else %>
              <%= form_with model: Consent.new(kind: kind), url: client_consents_path(@client), class: "inline-form compact" do |form| %>
                <%= form.hidden_field :kind %>
                <%= form.select :channel, enum_options(Consent, :channel), {}, aria: { label: Consent.human_attribute_name(:channel) } %>
                <%= form.submit t("consents.record"), class: "btn btn-primary" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <% if can?(:delete_records) && !@client.anonymized? %>
    <details class="anonymize">
      <summary class="link-button danger"><%= t("privacy.anonymize") %></summary>
      <%= form_with url: client_anonymization_path(@client), class: "inline-form", data: { turbo_confirm: t("privacy.confirm") } do |form| %>
        <%= form.text_field :reason, required: true, placeholder: t("privacy.reason_placeholder"), aria: { label: t("privacy.reason_placeholder") } %>
        <%= form.submit t("privacy.anonymize"), class: "btn btn-danger" %>
      <% end %>
      <p class="hint"><%= t("privacy.anonymize_hint") %></p>
    </details>
  <% end %>
  <% if @consents.reject(&:active?).any? %>
    <details class="small muted"><summary><%= t("consents.history") %></summary>
      <ul>
        <% @consents.reject(&:active?).each do |c| %>
          <li><%= t("consents.kinds.#{c.kind}") %>: <%= l(c.given_at.to_date) %> — <%= t("consents.withdrawn_line", date: l(c.withdrawn_at.to_date), reason: c.withdrawal_reason) %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</section>

<% spent = @client.total_spent %>
<section class="card loyalty">
  <h2><%= t("clients.sections.discount") %>: <%= enum_label(Client, :discount_mode, @client.discount_mode) %></h2>
  <div class="stats">
    <div class="stat"><span class="stat-value"><%= money(spent) %></span><span class="stat-label"><%= t("clients.total_spent") %></span></div>
    <div class="stat"><span class="stat-value"><%= number(@client.labor_discount) %>%</span><span class="stat-label"><%= t("clients.labor_discount") %></span></div>
    <div class="stat"><span class="stat-value"><%= number(@client.parts_discount) %>%</span><span class="stat-label"><%= t("clients.parts_discount") %></span></div>
  </div>
  <% if @client.discount_accumulative? && (next_tier = LoyaltyTier.next_after(spent)) %>
    <p class="muted"><%= t("clients.next_tier", amount: money(next_tier.threshold - spent), labor: number(next_tier.labor_percent), parts: number(next_tier.parts_percent)) %></p>
  <% end %>
</section>

<section class="card">
  <h2><%= t("nav.work_orders") %></h2>
  <%= render "work_orders/table", work_orders: @work_orders, show_client: false %>
</section>

<% if @client.leads.any? %>
  <section class="card">
    <h2><%= t("nav.leads") %></h2>
    <ul class="list">
      <% @client.leads.order(created_at: :desc).each do |lead| %>
        <li><%= link_to l(lead.created_at.to_date), lead %> <%= render "leads/status_badge", lead: lead %> <span class="muted"><%= truncate(lead.request, length: 80) %></span></li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "tasks/section", subject: @client %>
<%= render "notes/section", notable: @client, notes: @notes %>
