<%= page_header t("nav.clients") do %>
  <%= link_to t("clients.new"), new_client_path(with_vehicle: 1), class: "btn btn-primary" if can?(:manage_clients) %>
<% end %>

<%= form_with url: clients_path, method: :get, class: "filters" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: t("clients.search_placeholder"), aria: { label: t("search") } %>
  <%= form.select :status, status_filter_options, selected: params[:status] %>
  <%= form.submit t("search"), class: "btn", name: nil %>
<% end %>

<% if @clients.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= Client.human_attribute_name(:name) %></th>
          <th><%= Client.human_attribute_name(:phone) %></th>
          <th><%= Client.human_attribute_name(:vehicles) %></th>
          <th><%= Client.human_attribute_name(:discount_percent) %></th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td>
              <%= link_to client.display_name, client %>
              <% if client.company? %><span class="badge"><%= enum_label(Client, :kind, :company) %></span><% end %>
            </td>
            <td><%= client.phone %></td>
            <td><%= client.vehicles.map(&:label).join("; ") %></td>
            <td><%= "#{number(client.discount_percent)}%" if client.discount_percent.positive? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination(@pagy) %>
<% else %>
  <p class="empty"><%= t("clients.empty") %></p>
<% end %>
