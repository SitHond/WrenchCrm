<% if tasks.any? %>
  <ul class="tasks">
    <% tasks.each do |task| %>
      <li class="task <%= "done" if task.done? %> <%= "overdue" if task.overdue? %>">
        <%= button_to toggle_task_path(task), method: :patch, class: "task-check", title: task.done? ? t("tasks.reopen") : t("tasks.complete"),
              aria: { label: task.done? ? t("tasks.reopen") : t("tasks.complete") } do %><%= task.done? ? "✓" : "" %><% end %>
        <div class="task-body">
          <div class="task-title"><%= task.title %></div>
          <div class="task-meta">
            <% if task.due_on %><span class="<%= "danger" if task.overdue? %>"><%= l(task.due_on, format: :short) %></span><% end %>
            <% if local_assigns[:show_assignee] && task.assignee %><span><%= task.assignee.name %></span><% end %>
            <% if local_assigns[:show_subject] && task.subject %>
              <%= link_to task_subject_label(task.subject), task.subject %>
            <% end %>
            <% if task.description.present? %><span><%= truncate(task.description, length: 80) %></span><% end %>
          </div>
        </div>
        <div class="task-actions">
          <%= link_to "✎", edit_task_path(task), class: "link-button", title: t("edit") %>
          <% if task.deletable_by?(current_user) %>
            <%= button_to "×", task_path(task), method: :delete, class: "link-button danger", title: t("delete"), form: { data: { turbo_confirm: t("confirm") } } %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="muted"><%= t("tasks.empty") %></p>
<% end %>
