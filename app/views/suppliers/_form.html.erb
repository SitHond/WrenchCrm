<%= form_with model: supplier, class: "form narrow" do |form| %>
  <%= render "shared/errors", record: supplier %>
  <div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
  <div class="row">
    <div class="field"><%= form.label :inn %><%= form.text_field :inn, inputmode: "numeric", maxlength: 12 %></div>
    <div class="field"><%= form.label :phone %><%= form.telephone_field :phone %></div>
  </div>
  <div class="row">
    <div class="field"><%= form.label :email %><%= form.email_field :email %></div>
    <div class="field"><%= form.label :contact_person %><%= form.text_field :contact_person %></div>
  </div>
  <div class="field"><%= form.label :comment %><%= form.text_area :comment, rows: 2 %></div>
  <div class="field checkbox"><%= form.check_box :active %><%= form.label :active %></div>
  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("cancel"), supplier.persisted? ? supplier : suppliers_path, class: "btn" %>
  </div>
<% end %>
