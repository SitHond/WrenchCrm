<%= page_header t("families.title", name: @family.name) do %>
  <%= link_to t("families.add_member"), new_person_path(family_id: @family.id), class: "btn btn-primary" if can?(:add_records) %>
  <%= link_to t("edit"), edit_family_path(@family), class: "btn" if can?(:edit_records) %>
  <%= button_to t("delete"), @family, method: :delete, class: "btn btn-danger",
        form: { data: { turbo_confirm: t("families.confirm_delete") } } if can?(:delete_records) %>
<% end %>

<% unless @family.active? %><p class="subtitle"><span class="badge"><%= t("status.inactive") %></span></p><% end %>

<section class="card">
  <h2><%= Family.human_attribute_name(:people) %></h2>
  <% if @family.people.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th><%= Person.human_attribute_name(:name) %></th>
            <th><%= Person.human_attribute_name(:family_role) %></th>
            <th><%= Person.human_attribute_name(:classification) %></th>
            <th><%= Person.human_attribute_name(:birthday) %></th>
            <th><%= Person.human_attribute_name(:phone) %></th>
          </tr>
        </thead>
        <tbody>
          <% @family.people.each do |person| %>
            <tr>
              <td><%= link_to person.short_name, person %></td>
              <td><%= enum_label(Person, :family_role, person.family_role) %></td>
              <td><%= classification_badge(person) %></td>
              <td><%= birthday_text(person) %></td>
              <td><%= person.cell_phone %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="muted"><%= t("families.no_members") %></p>
  <% end %>
</section>

<div class="grid-2">
  <section class="card">
    <h2><%= t("people.sections.contacts") %></h2>
    <dl class="details">
      <%= detail_row Family.human_attribute_name(:address), safe_join(@family.address_lines, tag.br) if @family.address_lines.any? %>
      <%= detail_row Family.human_attribute_name(:home_phone), @family.home_phone %>
      <%= detail_row Family.human_attribute_name(:email), (mail_to(@family.email) if @family.email.present?) %>
      <%= detail_row Family.human_attribute_name(:wedding_date), @family.wedding_date && l(@family.wedding_date, format: :long) %>
      <%= detail_row Family.human_attribute_name(:send_newsletter), t(@family.send_newsletter? ? "yes" : "no") %>
    </dl>
  </section>

  <%= render "notes/section", notable: @family, notes: @notes %>
</div>
