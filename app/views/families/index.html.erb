<%= page_header t("nav.families") do %>
  <%= link_to t("families.new"), new_family_path, class: "btn btn-primary" if can?(:add_records) %>
<% end %>

<%= form_with url: families_path, method: :get, class: "filters" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: t("families.search_placeholder"), aria: { label: t("search") } %>
  <%= form.select :status, [ [ t("status.active"), "active" ], [ t("status.inactive"), "inactive" ] ], selected: params[:status] %>
  <%= form.submit t("search"), class: "btn", name: nil %>
<% end %>

<% if @families.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= Family.human_attribute_name(:name) %></th>
          <th><%= Family.human_attribute_name(:people) %></th>
          <th><%= Family.human_attribute_name(:city) %></th>
          <th><%= Family.human_attribute_name(:home_phone) %></th>
          <th><%= Family.human_attribute_name(:email) %></th>
        </tr>
      </thead>
      <tbody>
        <% @families.each do |family| %>
          <tr>
            <td><%= link_to family.name, family %></td>
            <td><%= family.people.map(&:first_name).join(", ") %></td>
            <td><%= family.city %></td>
            <td><%= family.home_phone %></td>
            <td><%= mail_to family.email if family.email.present? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination(@pagy) %>
<% else %>
  <p class="empty"><%= t("families.empty") %></p>
<% end %>
