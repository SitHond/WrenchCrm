<%= page_header t("finance.titles.#{@operation.kind}") %>

<%= form_with model: @operation, class: "form narrow" do |form| %>
  <%= render "shared/errors", record: @operation %>
  <%= form.hidden_field :kind %>
  <% if @operation.supplier_payment? %>
    <div class="field">
      <%= form.label :supplier_id %>
      <%= form.collection_select :supplier_id, Supplier.active.ordered, :id, ->(s) { "#{s.name} (#{t("suppliers.debt")}: #{money(s.debt)})" }, { include_blank: true }, required: true %>
    </div>
  <% else %>
    <div class="field">
      <%= form.label :expense_category_id %>
      <%= form.collection_select :expense_category_id, ExpenseCategory.active.where(kind: @operation.other_income? ? :income : :expense).ordered, :id, :name, include_blank: "—" %>
    </div>
  <% end %>
  <div class="row">
    <div class="field"><%= form.label :amount %><%= form.number_field :amount, step: 0.01, min: 0.01, required: true, value: @operation.amount&.abs %></div>
    <div class="field"><%= form.label :cash_account_id %><%= form.collection_select :cash_account_id, CashAccount.active.ordered, :id, :name %></div>
  </div>
  <div class="field"><%= form.label :occurred_at %><%= form.datetime_field :occurred_at, required: true %></div>
  <div class="field"><%= form.label :comment %><%= form.text_field :comment %></div>
  <div class="form-actions">
    <%= form.submit t("save"), class: "btn btn-primary" %>
    <%= link_to t("cancel"), cash_operations_path, class: "btn" %>
  </div>
<% end %>
