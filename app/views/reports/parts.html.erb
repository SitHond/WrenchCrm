<%= page_header t("nav.reports") %>
<%= render "tabs" %>
<%= render "shared/period_filter", url: parts_reports_path %>

<div class="stats">
  <div class="stat"><span class="stat-value"><%= money(@report.revenue) %></span><span class="stat-label"><%= t("reports.parts_revenue") %></span></div>
  <div class="stat"><span class="stat-value"><%= money(@report.cost) %></span><span class="stat-label"><%= t("reports.parts_cost") %></span></div>
  <div class="stat"><span class="stat-value ok"><%= money(@report.margin) %></span><span class="stat-label"><%= t("reports.margin") %></span></div>
</div>

<% if @report.rows.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= Part.model_name.human %></th>
          <th class="num"><%= Part.human_attribute_name(:quantity) %></th>
          <th class="num"><%= t("reports.parts_revenue") %></th>
          <th class="num"><%= t("reports.parts_cost") %></th>
          <th class="num"><%= t("reports.margin") %></th>
          <th class="num">%</th>
        </tr>
      </thead>
      <tbody>
        <% @report.rows.each do |row| %>
          <tr>
            <td><%= row.name %></td>
            <td class="num"><%= number(row.quantity) %></td>
            <td class="num"><%= money(row.revenue) %></td>
            <td class="num"><%= money(row.cost) %></td>
            <td class="num <%= row.margin.negative? ? "danger" : "" %>"><%= money(row.margin) %></td>
            <td class="num"><%= row.margin_percent %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="hint"><%= t("reports.parts_note") %></p>
<% else %>
  <p class="empty"><%= t("reports.no_data") %></p>
<% end %>
