<%= page_header t("shop_settings.title") %>

<%= form_with model: @setting, url: shop_settings_path, method: :patch, class: "form" do |form| %>
  <%= render "shared/errors", record: @setting %>

  <fieldset>
    <legend><%= t("shop_settings.sections.company") %></legend>
    <div class="row">
      <div class="field"><%= form.label :name %><%= form.text_field :name %></div>
      <div class="field wide"><%= form.label :legal_name %><%= form.text_field :legal_name, placeholder: "ООО «Гайка»" %></div>
    </div>
    <div class="row">
      <div class="field"><%= form.label :inn %><%= form.text_field :inn, inputmode: "numeric", maxlength: 12 %></div>
      <div class="field"><%= form.label :kpp %><%= form.text_field :kpp, inputmode: "numeric", maxlength: 9 %></div>
      <div class="field"><%= form.label :ogrn %><%= form.text_field :ogrn, inputmode: "numeric", maxlength: 15 %></div>
    </div>
    <div class="field"><%= form.label :address %><%= form.text_field :address %></div>
    <div class="row">
      <div class="field"><%= form.label :phone %><%= form.telephone_field :phone %></div>
      <div class="field"><%= form.label :email %><%= form.email_field :email %></div>
      <div class="field"><%= form.label :website %><%= form.text_field :website %></div>
    </div>
    <div class="field"><%= form.label :director %><%= form.text_field :director %></div>
  </fieldset>

  <fieldset>
    <legend><%= t("shop_settings.sections.bank") %></legend>
    <div class="row">
      <div class="field wide"><%= form.label :bank_name %><%= form.text_field :bank_name %></div>
      <div class="field"><%= form.label :bik %><%= form.text_field :bik, inputmode: "numeric", maxlength: 9 %></div>
    </div>
    <div class="row">
      <div class="field"><%= form.label :bank_account %><%= form.text_field :bank_account, inputmode: "numeric", maxlength: 20, class: "mono" %></div>
      <div class="field"><%= form.label :correspondent_account %><%= form.text_field :correspondent_account, inputmode: "numeric", maxlength: 20, class: "mono" %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("shop_settings.sections.documents") %></legend>
    <div class="field"><%= form.label :work_order_terms %><%= form.text_area :work_order_terms, rows: 4, placeholder: t("shop_settings.terms_placeholder") %></div>
  </fieldset>

  <fieldset>
    <legend><%= t("consents.title") %></legend>
    <div class="field"><%= form.label :pd_consent_text %><%= form.text_area :pd_consent_text, rows: 8, placeholder: t("consents.default_text.personal_data", locale: :ru) %></div>
    <div class="field"><%= form.label :marketing_consent_text %><%= form.text_area :marketing_consent_text, rows: 4, placeholder: t("consents.default_text.marketing", locale: :ru) %></div>
    <p class="hint"><%= t("consents.settings_hint") %></p>
  </fieldset>

  <fieldset>
    <legend><%= t("shop_settings.sections.stock") %></legend>
    <div class="field checkbox"><%= form.check_box :allow_negative_stock %><%= form.label :allow_negative_stock %></div>
    <p class="hint"><%= t("shop_settings.negative_stock_hint") %></p>
  </fieldset>

  <div class="form-actions"><%= form.submit t("save"), class: "btn btn-primary" %></div>
<% end %>

<section class="card" id="complexity">
  <h2><%= t("shop_settings.complexity_levels") %></h2>
  <p class="hint"><%= t("shop_settings.complexity_hint") %></p>
  <% if @complexity_levels.any? %>
    <ul class="list">
      <% @complexity_levels.each do |level| %>
        <li><%= level.name %>
          <%= button_to t("delete"), complexity_level_path(level), method: :delete, class: "link-button danger", form: { data: { turbo_confirm: t("confirm") } } %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: ComplexityLevel.new, class: "inline-form" do |form| %>
    <%= form.text_field :name, required: true, placeholder: t("shop_settings.complexity_placeholder"), aria: { label: ComplexityLevel.human_attribute_name(:name) } %>
    <%= form.submit t("add"), class: "btn" %>
  <% end %>
</section>

<section class="card" id="loyalty">
  <h2><%= t("shop_settings.loyalty_tiers") %></h2>
  <p class="hint"><%= t("shop_settings.loyalty_hint") %></p>
  <% if @loyalty_tiers.any? %>
    <ul class="list">
      <% @loyalty_tiers.each do |tier| %>
        <li>
          <%= t("shop_settings.tier_line", amount: money(tier.threshold), labor: number(tier.labor_percent), parts: number(tier.parts_percent)) %>
          <%= button_to t("delete"), loyalty_tier_path(tier), method: :delete, class: "link-button danger" %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: LoyaltyTier.new, class: "inline-form" do |form| %>
    <%= form.number_field :threshold, min: 1, step: 1, required: true, class: "price", placeholder: LoyaltyTier.human_attribute_name(:threshold), aria: { label: LoyaltyTier.human_attribute_name(:threshold) } %>
    <%= form.number_field :labor_percent, min: 0, max: 100, step: 0.5, class: "qty", placeholder: "%", aria: { label: LoyaltyTier.human_attribute_name(:labor_percent) } %>
    <span class="muted"><%= t("shop_settings.tier_labor") %></span>
    <%= form.number_field :parts_percent, min: 0, max: 100, step: 0.5, class: "qty", placeholder: "%", aria: { label: LoyaltyTier.human_attribute_name(:parts_percent) } %>
    <span class="muted"><%= t("shop_settings.tier_parts") %></span>
    <%= form.submit t("add"), class: "btn" %>
  <% end %>
</section>

<section class="card" id="ad-sources">
  <h2><%= AdSource.model_name.human(count: 2) %></h2>
  <% if @ad_sources.any? %>
    <ul class="list">
      <% @ad_sources.each do |source| %>
        <li class="<%= "inactive" unless source.active? %>">
          <%= source.name %>
          <span class="spacer"></span>
          <%= button_to source.active? ? t("finance.hide") : t("finance.show"), ad_source_path(source), method: :patch, class: "link-button" %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: AdSource.new, class: "inline-form" do |form| %>
    <%= form.text_field :name, required: true, placeholder: t("shop_settings.ad_source_placeholder"), aria: { label: AdSource.human_attribute_name(:name) } %>
    <%= form.submit t("add"), class: "btn" %>
  <% end %>
</section>

<section class="card" id="markup">
  <h2><%= t("shop_settings.markup_rules") %></h2>
  <p class="hint"><%= t("shop_settings.markup_hint") %></p>
  <% rules = MarkupRule.ordered %>
  <% if rules.any? %>
    <ul class="list">
      <% rules.each do |rule| %>
        <li><%= t("shop_settings.markup_line", cost: money(rule.cost_from), percent: number(rule.percent)) %>
          <%= button_to t("delete"), markup_rule_path(rule), method: :delete, class: "link-button danger" %></li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: MarkupRule.new, class: "inline-form" do |form| %>
    <span class="muted"><%= t("shop_settings.markup_from") %></span>
    <%= form.number_field :cost_from, min: 0, step: 1, required: true, class: "price", aria: { label: MarkupRule.human_attribute_name(:cost_from) } %>
    <span class="muted">+</span>
    <%= form.number_field :percent, min: 0, step: 1, required: true, class: "qty", aria: { label: MarkupRule.human_attribute_name(:percent) } %>%
    <%= form.submit t("add"), class: "btn" %>
  <% end %>
</section>

<section class="card" id="categories">
  <h2><%= CatalogCategory.model_name.human(count: 2) %></h2>
  <div class="grid-2">
    <% CatalogCategory.kinds.each_key do |kind| %>
      <div>
        <h3><%= enum_label(CatalogCategory, :kind, kind) %></h3>
        <ul class="list">
          <% CatalogCategory.where(kind: kind).ordered.each do |category| %>
            <li><%= category.name %>
              <%= button_to t("delete"), catalog_category_path(category), method: :delete, class: "link-button danger", form: { data: { turbo_confirm: t("confirm") } } %></li>
          <% end %>
        </ul>
        <%= form_with model: CatalogCategory.new(kind: kind), class: "inline-form" do |form| %>
          <%= form.hidden_field :kind %>
          <%= form.text_field :name, required: true, placeholder: t("shop_settings.category_placeholder.#{kind}"), aria: { label: CatalogCategory.human_attribute_name(:name) } %>
          <%= form.submit t("add"), class: "btn" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
