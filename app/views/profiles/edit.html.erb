<%= page_header t("profiles.title") %>
<%= form_with model: @user, url: profile_path, method: :patch, class: "form narrow" do |form| %>
  <%= render "shared/errors", record: @user %>
  <div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
  <div class="field"><%= form.label :email_address %><%= form.email_field :email_address, disabled: true %></div>
  <div class="field"><%= form.label :locale %><%= form.select :locale, User::LOCALES.map { |l| [ t("locales.#{l}"), l ] } %></div>
  <fieldset>
    <legend><%= t("profiles.change_password") %></legend>
    <div class="field"><%= form.label :password_challenge %><%= form.password_field :password_challenge, autocomplete: "current-password" %></div>
    <div class="field"><%= form.label :password %><%= form.password_field :password, autocomplete: "new-password" %></div>
    <div class="field"><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, autocomplete: "new-password" %></div>
  </fieldset>
  <div class="form-actions"><%= form.submit t("save"), class: "btn btn-primary" %></div>
<% end %>

<section class="card form narrow">
  <h2><%= t("two_factor.title") %></h2>
  <% if current_user.two_factor_enabled? %>
    <p><%= t("two_factor.status_on", date: l(current_user.otp_enabled_at.to_date), codes: current_user.backup_codes_left) %></p>
    <%= form_with url: two_factor_path, method: :delete, class: "inline-form" do |form| %>
      <%= form.password_field :password, required: true, placeholder: User.human_attribute_name(:password_challenge), autocomplete: "current-password", aria: { label: User.human_attribute_name(:password_challenge) } %>
      <%= form.text_field :code, required: true, placeholder: t("two_factor.code"), autocomplete: "one-time-code", class: "qty", aria: { label: t("two_factor.code") } %>
      <%= form.submit t("two_factor.disable"), class: "btn btn-danger" %>
    <% end %>
  <% else %>
    <p class="muted"><%= t("two_factor.status_off") %></p>
    <%= link_to t("two_factor.setup"), new_two_factor_path, class: "btn btn-primary" %>
  <% end %>
</section>
