<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), t("app.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="shell">
      <aside class="sidebar">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">✚</span> <%= t("app.name") %>
        <% end %>
        <nav>
          <%= nav_link t("nav.dashboard"), root_path, active_prefix: "/" %>
          <%= nav_link t("nav.people"), people_path %>
          <%= nav_link t("nav.families"), families_path %>
          <%= nav_link t("nav.groups"), groups_path %>
          <% if can?(:admin) %>
            <div class="nav-section"><%= t("nav.admin") %></div>
            <%= nav_link t("nav.users"), admin_users_path %>
          <% end %>
        </nav>
        <div class="sidebar-footer">
          <%= link_to current_user.name, edit_profile_path, class: "nav-link" %>
          <%= render "shared/locale_switcher" %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "link-button" %>
        </div>
      </aside>

      <main class="content">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
