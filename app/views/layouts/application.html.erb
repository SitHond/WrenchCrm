<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), t("app.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#1f2937">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="nav" data-action="keydown.esc@window->nav#close">
    <header class="topbar">
      <button type="button" class="topbar-button" data-action="nav#toggle" aria-label="<%= t("nav.menu") %>" aria-controls="sidebar" data-nav-target="toggle" aria-expanded="false">
        <span class="burger"></span>
      </button>
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-mark">🔧</span> <%= t("app.name") %>
      <% end %>
    </header>
    <div class="nav-overlay" data-action="click->nav#close"></div>

    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark">🔧</span> <%= t("app.name") %>
        <% end %>
        <nav>
          <%= nav_link t("nav.dashboard"), root_path, active_prefix: "/" %>
          <%= link_to tasks_path, class: [ "nav-link", ("active" if request.path.start_with?(tasks_path)) ] do %>
            <%= t("nav.tasks") %><% if my_due_tasks_count.positive? %> <span class="nav-badge"><%= my_due_tasks_count %></span><% end %>
          <% end %>
          <%= nav_link t("nav.work_orders"), work_orders_path %>
          <%= nav_link t("nav.appointments"), appointments_path %>
          <%= nav_link t("nav.calendar"), calendar_path %>
          <%= nav_link t("nav.clients"), clients_path %>
          <%= nav_link t("nav.vehicles"), vehicles_path %>
          <%= nav_link t("nav.sales"), sales_path %>
          <div class="nav-section"><%= t("nav.stock") %></div>
          <%= nav_link t("nav.parts"), parts_path %>
          <%= nav_link t("nav.purchase_receipts"), purchase_receipts_path %>
          <%= nav_link t("nav.suppliers"), suppliers_path %>
          <%= nav_link t("nav.services"), services_path %>
          <% if can?(:manage_finance) || can?(:view_reports) %>
            <div class="nav-section"><%= t("nav.finance") %></div>
            <%= nav_link t("nav.cash"), cash_operations_path if can?(:manage_finance) %>
            <%= nav_link t("nav.payroll"), payroll_index_path if can?(:manage_finance) %>
            <%= nav_link t("nav.reports"), reports_path if can?(:view_reports) %>
          <% end %>
          <% if can?(:admin) %>
            <div class="nav-section"><%= t("nav.admin") %></div>
            <%= nav_link t("nav.employees"), admin_employees_path %>
            <%= nav_link t("nav.bays"), admin_bays_path %>
            <%= nav_link t("nav.users"), admin_users_path %>
            <%= nav_link t("nav.settings"), edit_shop_settings_path %>
          <% end %>
        </nav>
        <div class="sidebar-footer">
          <%= link_to current_user.name, edit_profile_path, class: "nav-link" %>
          <%= render "shared/locale_switcher" %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "link-button" %>
          <span class="version">v<%= Rails.configuration.x.version.delete_prefix("v") %></span>
        </div>
      </aside>

      <main class="content">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>

    <nav class="tabbar" aria-label="<%= t("nav.quick") %>">
      <%= link_to root_path, class: [ "tab-item", ("active" if request.path == root_path) ] do %>
        <span class="tab-icon">⌂</span><span><%= t("nav.dashboard") %></span>
      <% end %>
      <%= link_to work_orders_path, class: [ "tab-item", ("active" if request.path.start_with?(work_orders_path)) ] do %>
        <span class="tab-icon">🛠</span><span><%= t("nav.work_orders_short") %></span>
      <% end %>
      <%= link_to appointments_path, class: [ "tab-item", ("active" if request.path.start_with?(appointments_path)) ] do %>
        <span class="tab-icon">🗓</span><span><%= t("nav.appointments") %></span>
      <% end %>
      <%= link_to clients_path, class: [ "tab-item", ("active" if request.path.start_with?(clients_path)) ] do %>
        <span class="tab-icon">👤</span><span><%= t("nav.clients") %></span>
      <% end %>
      <button type="button" class="tab-item" data-action="nav#toggle">
        <span class="tab-icon">☰</span><span><%= t("nav.more") %></span>
      </button>
    </nav>
  </body>
</html>
