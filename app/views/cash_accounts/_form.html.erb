<%= form_with model: account, class: "form narrow" do |form| %>
  <%= render "shared/errors", record: account %>
  <div class="row">
    <div class="field wide"><%= form.label :name %><%= form.text_field :name, required: true %></div>
    <div class="field"><%= form.label :kind %><%= form.select :kind, enum_options(CashAccount, :kind) %></div>
    <div class="field small"><%= form.label :position %><%= form.number_field :position, min: 0 %></div>
  </div>
  <div class="field checkbox"><%= form.check_box :active %><%= form.label :active %></div>
  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("cancel"), cash_accounts_path, class: "btn" %>
  </div>
<% end %>
