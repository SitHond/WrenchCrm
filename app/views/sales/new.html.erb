<%= page_header t("sales.new") %>

<%= form_with model: @sale, class: "form" do |form| %>
  <%= render "shared/errors", record: @sale %>
  <fieldset>
    <legend><%= t("sales.items") %></legend>
    <%= form.fields_for :lines do |line| %>
      <div class="line-form tight">
        <%= line.collection_select :part_id, Part.active.ordered, :id,
              ->(p) { "#{p.label} — #{money(p.price)} (#{quantity_with_unit(p.quantity, p.unit)})" },
              { include_blank: t("work_orders.from_stock") }, aria: { label: Part.model_name.human } %>
        <%= line.text_field :name, placeholder: t("work_orders.or_custom_name"), aria: { label: SaleLine.human_attribute_name(:name) } %>
        <%= line.number_field :quantity, step: 0.001, min: 0.001, class: "qty", aria: { label: SaleLine.human_attribute_name(:quantity) } %>
        <%= line.number_field :price, step: 0.01, min: 0, class: "price", placeholder: SaleLine.human_attribute_name(:price), aria: { label: SaleLine.human_attribute_name(:price) } %>
      </div>
    <% end %>
    <p class="hint"><%= t("sales.lines_hint") %></p>
  </fieldset>

  <fieldset>
    <div class="row">
      <div class="field"><%= form.label :client_id %><%= form.collection_select :client_id, Client.active.ordered, :id, :display_name, include_blank: t("sales.walk_in") %></div>
      <div class="field"><%= form.label :payment_method %><%= form.select :payment_method, enum_options(Sale, :payment_method) %></div>
      <div class="field"><%= form.label :cash_account_id %><%= form.collection_select :cash_account_id, CashAccount.active.ordered, :id, :name, include_blank: t("sales.auto_account") %></div>
      <div class="field small"><%= form.label :discount_percent %><%= form.number_field :discount_percent, min: 0, max: 100, step: 0.5 %></div>
    </div>
    <div class="field"><%= form.label :comment %><%= form.text_field :comment %></div>
  </fieldset>

  <div class="form-actions">
    <%= form.submit t("sales.submit"), class: "btn btn-primary" %>
    <%= link_to t("cancel"), sales_path, class: "btn" %>
  </div>
<% end %>
