<%= page_header t("nav.purchase_receipts") do %>
  <%= link_to t("purchase_receipts.new"), new_purchase_receipt_path, class: "btn btn-primary" if can?(:manage_catalog) %>
<% end %>

<%= form_with url: purchase_receipts_path, method: :get, class: "filters" do |form| %>
  <%= form.collection_select :supplier_id, Supplier.ordered, :id, :name, { include_blank: t("purchase_receipts.all_suppliers"), selected: params[:supplier_id] }, aria: { label: Supplier.model_name.human } %>
  <%= form.select :status, enum_options(PurchaseReceipt, :status), { include_blank: t("filter.all"), selected: params[:status] }, aria: { label: PurchaseReceipt.human_attribute_name(:status) } %>
  <%= form.submit t("search"), class: "btn", name: nil %>
<% end %>

<%= render "table", receipts: @receipts %>
<%= pagination(@pagy) %>
