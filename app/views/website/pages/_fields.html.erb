<div class="row">
  <div class="field wide"><%= form.label :title %><%= form.text_field :title, required: true %></div>
  <div class="field"><%= form.label :slug %><%= form.text_field :slug, placeholder: "about" %></div>
  <div class="field small"><%= form.label :position %><%= form.number_field :position %></div>
</div>
<div class="field"><%= form.label :body %><%= form.text_area :body, rows: 12 %></div>
<p class="hint"><%= t("website.body_hint") %></p>
<div class="field checkbox"><%= form.check_box :published %><%= form.label :published %></div>
<div class="field checkbox"><%= form.check_box :show_in_menu %><%= form.label :show_in_menu %></div>
