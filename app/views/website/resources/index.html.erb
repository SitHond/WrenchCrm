<%= page_header t("website.title") do %>
  <%= link_to t("website.open_site"), website_public_url, class: "btn", target: "_blank" %>
  <%= link_to t("website.new.#{resource_name}"), url_for(action: :new), class: "btn btn-primary" %>
<% end %>
<%= render "website/tabs" %>

<% if @records.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= t("website.column.name") %></th><th><%= t("website.column.shown") %></th><th><%= t("website.column.period") %></th><th></th></tr></thead>
      <tbody>
        <% @records.each do |record| %>
          <tr class="<%= "inactive" unless website_visible?(record) %>">
            <td>
              <% if record.respond_to?(:image) && record.image.attached? && record.image.blob.persisted? %><%= image_tag record.image, class: "thumb", alt: "" %><% end %>
              <%= link_to website_label(record), url_for(action: :edit, id: record) %>
            </td>
            <td><%= t(website_visible?(record) ? "yes" : "no") %></td>
            <td class="muted small"><%= website_period(record) %></td>
            <td class="actions-cell"><%= button_to t("delete"), url_for(action: :destroy, id: record), method: :delete, class: "link-button danger", form: { data: { turbo_confirm: t("confirm") } } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty"><%= t("website.empty.#{resource_name}") %></p>
<% end %>
