<%= form_with model: person, class: "form" do |form| %>
  <%= render "shared/errors", record: person %>

  <fieldset>
    <legend><%= t("people.sections.name") %></legend>
    <div class="row">
      <div class="field small"><%= form.label :title %><%= form.text_field :title %></div>
      <div class="field"><%= form.label :first_name %><%= form.text_field :first_name, required: true %></div>
      <div class="field"><%= form.label :middle_name %><%= form.text_field :middle_name %></div>
      <div class="field"><%= form.label :last_name %><%= form.text_field :last_name, required: true %></div>
      <div class="field small"><%= form.label :suffix %><%= form.text_field :suffix %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("people.sections.church") %></legend>
    <div class="row">
      <div class="field"><%= form.label :family_id %><%= form.collection_select :family_id, Family.active.ordered, :id, :name, include_blank: t("people.no_family") %></div>
      <div class="field"><%= form.label :family_role %><%= form.select :family_role, enum_options(Person, :family_role) %></div>
      <div class="field"><%= form.label :classification %><%= form.select :classification, enum_options(Person, :classification) %></div>
    </div>
    <div class="row">
      <div class="field"><%= form.label :membership_date %><%= form.date_field :membership_date %></div>
      <div class="field"><%= form.label :friend_date %><%= form.date_field :friend_date %></div>
      <div class="field"><%= form.label :deactivated_on %><%= form.date_field :deactivated_on %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("people.sections.personal") %></legend>
    <div class="row">
      <div class="field"><%= form.label :gender %><%= form.select :gender, enum_options(Person, :gender) %></div>
      <div class="field small"><%= form.label :birth_day %><%= form.number_field :birth_day, in: 1..31 %></div>
      <div class="field">
        <%= form.label :birth_month %>
        <%= form.select :birth_month, (1..12).map { |m| [ t("date.standalone_month_names", default: t("date.month_names"))[m], m ] }, include_blank: true %>
      </div>
      <div class="field small"><%= form.label :birth_year %><%= form.number_field :birth_year, in: 1850..2200 %></div>
      <div class="field"><%= form.label :deceased_on %><%= form.date_field :deceased_on %></div>
    </div>
    <p class="hint"><%= t("people.birth_year_hint") %></p>
  </fieldset>

  <fieldset>
    <legend><%= t("people.sections.contacts") %></legend>
    <div class="row">
      <div class="field"><%= form.label :email %><%= form.email_field :email %></div>
      <div class="field"><%= form.label :work_email %><%= form.email_field :work_email %></div>
    </div>
    <div class="row">
      <div class="field"><%= form.label :cell_phone %><%= form.telephone_field :cell_phone %></div>
      <div class="field"><%= form.label :home_phone %><%= form.telephone_field :home_phone %></div>
      <div class="field"><%= form.label :work_phone %><%= form.telephone_field :work_phone %></div>
    </div>
    <div class="row">
      <div class="field"><%= form.label :telegram %><%= form.text_field :telegram %></div>
      <div class="field"><%= form.label :facebook %><%= form.text_field :facebook %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("people.sections.address") %></legend>
    <p class="hint"><%= t("people.address_hint") %></p>
    <%= render "shared/address_fields", form: form %>
  </fieldset>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("cancel"), person.persisted? ? person : people_path, class: "btn" %>
  </div>
<% end %>
