<%= page_header t("nav.people") do %>
  <%= link_to t("people.new"), new_person_path, class: "btn btn-primary" if can?(:add_records) %>
<% end %>

<%= form_with url: people_path, method: :get, class: "filters", data: { turbo_frame: "_top" } do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: t("people.search_placeholder"), aria: { label: t("search") } %>
  <%= form.select :classification, enum_options(Person, :classification), { include_blank: t("people.all_classifications"), selected: params[:classification] } %>
  <%= form.select :status, [ [ t("status.active"), "active" ], [ t("status.inactive"), "inactive" ] ], selected: params[:status] %>
  <%= form.submit t("search"), class: "btn", name: nil %>
<% end %>

<% if @people.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th><%= Person.human_attribute_name(:name) %></th>
          <th><%= Person.human_attribute_name(:family) %></th>
          <th><%= Person.human_attribute_name(:classification) %></th>
          <th><%= Person.human_attribute_name(:phone) %></th>
          <th><%= Person.human_attribute_name(:email) %></th>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <tr>
            <td><%= link_to "#{person.last_name} #{person.first_name}", person %></td>
            <td><%= link_to person.family.name, person.family if person.family %></td>
            <td><%= classification_badge(person) %></td>
            <td><%= person.effective_phone %></td>
            <td><%= mail_to person.email if person.email.present? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination(@pagy) %>
<% else %>
  <p class="empty"><%= t("people.empty") %></p>
<% end %>
