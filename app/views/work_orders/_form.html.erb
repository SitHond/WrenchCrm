<%= form_with model: work_order, class: "form" do |form| %>
  <%= render "shared/errors", record: work_order %>
  <%= form.hidden_field :status if work_order.new_record? && work_order.estimate? %>

  <fieldset>
    <legend><%= t("work_orders.sections.vehicle") %></legend>
    <% if work_order.new_record? %>
      <div class="field">
        <%= form.label :vehicle_id %>
        <%= form.grouped_collection_select :vehicle_id, Client.active.ordered.includes(:vehicles).select { |c| c.vehicles.any? },
              :vehicles, :display_name, :id, :label, { include_blank: true }, required: true %>
      </div>
      <p class="hint"><%= t("work_orders.new_client_hint_html", link: link_to(t("clients.new"), new_client_path(with_vehicle: 1))) %></p>
    <% else %>
      <p><%= link_to work_order.vehicle.label, work_order.vehicle %> · <%= link_to work_order.client.display_name, work_order.client %></p>
    <% end %>
    <div class="row">
      <div class="field"><%= form.label :mileage %><%= form.number_field :mileage, min: 0 %></div>
      <div class="field"><%= form.label :mechanic_id %><%= form.collection_select :mechanic_id, Employee.active.ordered, :id, :name, include_blank: true %></div>
      <div class="field"><%= form.label :advisor_id %><%= form.collection_select :advisor_id, Employee.active.ordered, :id, :name, include_blank: true, selected: work_order.advisor_id || current_user.employee&.id %></div>
      <div class="field"><%= form.label :promised_at %><%= form.datetime_field :promised_at %></div>
    </div>
    <div class="row">
      <% if ComplexityLevel.exists? %>
        <div class="field"><%= form.label :complexity_level_id %><%= form.collection_select :complexity_level_id, ComplexityLevel.ordered, :id, :name, include_blank: "—" %></div>
      <% end %>
      <div class="field small"><%= form.label :labor_discount_percent %><%= form.number_field :labor_discount_percent, min: 0, max: 100, step: 0.5 %></div>
      <div class="field small"><%= form.label :parts_discount_percent %><%= form.number_field :parts_discount_percent, min: 0, max: 100, step: 0.5 %></div>
      <div class="field small"><%= form.label :discount_amount %><%= form.number_field :discount_amount, min: 0, step: 1 %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("work_orders.sections.intake") %></legend>
    <div class="row">
      <div class="field small"><%= form.label :fuel_level %><%= form.number_field :fuel_level, min: 0, max: 100, step: 5 %></div>
      <div class="field wide"><%= form.label :intake_condition %><%= form.text_area :intake_condition, rows: 2, placeholder: t("work_orders.intake_condition_placeholder") %></div>
    </div>
    <div class="field"><%= form.label :intake_items %><%= form.text_area :intake_items, rows: 2, placeholder: t("work_orders.intake_items_placeholder") %></div>
  </fieldset>

  <fieldset>
    <div class="field"><%= form.label :complaint %><%= form.text_area :complaint, rows: 3 %></div>
    <div class="field"><%= form.label :diagnosis %><%= form.text_area :diagnosis, rows: 3 %></div>
    <div class="field"><%= form.label :recommendations %><%= form.text_area :recommendations, rows: 3 %></div>
    <% previous = work_order.vehicle ? work_order.vehicle.work_orders.closed.where.not(id: work_order.id).reorder(closed_at: :desc) : WorkOrder.none %>
    <% if previous.any? %>
      <div class="field"><%= form.label :warranty_of_id %><%= form.collection_select :warranty_of_id, previous, :id, ->(o) { "№ #{o.number} · #{l((o.closed_at || o.created_at).to_date)}" }, include_blank: t("warranty.not_a_claim") %></div>
    <% end %>
    <div class="field"><%= form.label :replaced_parts %><%= form.select :replaced_parts, enum_options(WorkOrder, :replaced_parts) %></div>
  </fieldset>

  <% if work_order.new_record? %><p class="hint"><%= t("work_orders.discount_hint") %></p><% end %>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("cancel"), work_order.persisted? ? work_order : work_orders_path, class: "btn" %>
  </div>
<% end %>
