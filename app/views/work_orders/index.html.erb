<%= page_header t("nav.work_orders") do %>
  <%= link_to t("work_orders.board"), board_work_orders_path, class: "btn" %>
  <%= csv_export_link %>
  <% if can?(:manage_orders) %>
    <%= link_to t("work_orders.new_estimate"), new_work_order_path(estimate: 1), class: "btn" %>
    <%= link_to t("work_orders.new"), new_work_order_path, class: "btn btn-primary" %>
  <% end %>
<% end %>

<%= form_with url: work_orders_path, method: :get, class: "filters" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: t("work_orders.search_placeholder"), aria: { label: t("search") } %>
  <%= form.select :status, [ [ t("work_orders.filter.unfinished"), "" ], *enum_options(WorkOrder, :status), [ t("work_orders.filter.all"), "all" ] ],
        selected: params[:status], aria: { label: WorkOrder.human_attribute_name(:status) } %>
  <% if AdSource.exists? %>
    <%= form.collection_select :ad_source_id, AdSource.ordered, :id, :name, { include_blank: t("clients.all_sources"), selected: params[:ad_source_id] }, aria: { label: Client.human_attribute_name(:ad_source) } %>
  <% end %>
  <%= form.submit t("search"), class: "btn", name: nil %>
<% end %>

<%= render "table", work_orders: @work_orders %>
<%= pagination(@pagy) %>
