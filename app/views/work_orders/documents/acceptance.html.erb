<% content_for :title, t("documents.acceptance.title", number: @work_order.number) %>
<article class="print-doc">
  <%= render "work_orders/documents/head", title: t("documents.acceptance.title", number: @work_order.number) %>
  <p><%= t("documents.acceptance.intro", shop: @shop.legal_name.presence || @shop.display_name, client: @work_order.client.display_name) %></p>
  <%= render "work_orders/documents/customer" %>

  <table class="print-info">
    <tr><th><%= WorkOrder.human_attribute_name(:fuel_level) %></th><td><%= @work_order.fuel_level ? "#{@work_order.fuel_level}%" : "____" %></td></tr>
    <tr><th><%= WorkOrder.human_attribute_name(:complaint) %></th><td><%= @work_order.complaint %></td></tr>
  </table>

  <h2><%= WorkOrder.human_attribute_name(:intake_condition) %></h2>
  <div class="fill-box"><%= @work_order.intake_condition.present? ? simple_format(@work_order.intake_condition) : tag.br * 3 %></div>
  <h2><%= WorkOrder.human_attribute_name(:intake_items) %></h2>
  <div class="fill-box"><%= @work_order.intake_items.present? ? simple_format(@work_order.intake_items) : tag.br * 2 %></div>

  <% client_parts = @work_order.part_lines.select(&:client_supplied?) %>
  <h2><%= t("documents.acceptance.client_parts") %></h2>
  <% if client_parts.any? %>
    <table class="print-lines">
      <thead><tr><th>#</th><th><%= WorkOrderLabor.human_attribute_name(:name) %></th><th class="num"><%= WorkOrderPart.human_attribute_name(:quantity) %></th><th class="num"><%= WorkOrderPart.human_attribute_name(:client_value) %></th></tr></thead>
      <tbody>
        <% client_parts.each_with_index do |line, index| %>
          <tr><td><%= index + 1 %></td><td><%= line.name %></td><td class="num"><%= number(line.quantity) %></td><td class="num"><%= line.client_value ? money(line.client_value) : "—" %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p><%= t("documents.acceptance.no_client_parts") %></p>
  <% end %>

  <p class="small"><%= t("documents.acceptance.note") %></p>
  <div class="signatures">
    <div><%= t("documents.acceptance.handed_over") %> ____________________<br><span class="muted"><%= @work_order.client.display_name %></span></div>
    <div><%= t("documents.acceptance.accepted") %> ____________________<% if @work_order.advisor %><br><span class="muted"><%= signer(@work_order.advisor) %></span><% end %></div>
  </div>
</article>
