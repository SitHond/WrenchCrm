<%= page_header t("groups.edit", name: @group.name) %>
<%= render "form", group: @group %>

<section class="card">
  <h2><%= t("groups.roles") %></h2>
  <ul class="list">
    <% @group.group_roles.each do |role| %>
      <li>
        <%= role.name %>
        <% if role.default? %>
          <span class="badge"><%= GroupRole.human_attribute_name(:default) %></span>
        <% else %>
          <%= button_to t("groups.make_default"), group_group_role_path(@group, role), method: :patch, class: "link-button" %>
          <%= button_to t("delete"), group_group_role_path(@group, role), method: :delete, class: "link-button danger",
                form: { data: { turbo_confirm: t("confirm") } } %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= form_with model: [ @group, GroupRole.new ], class: "inline-form" do |form| %>
    <%= form.text_field :name, required: true, placeholder: GroupRole.human_attribute_name(:name), aria: { label: GroupRole.human_attribute_name(:name) } %>
    <%= form.submit t("groups.add_role"), class: "btn" %>
  <% end %>
</section>
