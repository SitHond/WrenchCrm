<%= page_header @group.name do %>
  <% if can?(:manage_groups) %>
    <%= link_to t("edit"), edit_group_path(@group), class: "btn" %>
    <%= button_to t("delete"), @group, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: t("confirm") } } %>
  <% end %>
<% end %>

<p class="subtitle">
  <%= enum_label(Group, :group_type, @group.group_type) %>
  <% unless @group.active? %>· <span class="badge"><%= t("status.inactive") %></span><% end %>
</p>
<% if @group.description.present? %>
  <div class="card prose"><%= simple_format(@group.description) %></div>
<% end %>

<section class="card">
  <h2><%= Group.human_attribute_name(:members_count) %>: <%= @memberships.size %></h2>

  <% if can?(:manage_groups) && @candidates.any? %>
    <%= form_with model: [ @group, GroupMembership.new ], class: "inline-form" do |form| %>
      <%= form.collection_select :person_id, @candidates, :id, ->(p) { "#{p.last_name} #{p.first_name}" }, {}, aria: { label: Person.model_name.human } %>
      <%= form.collection_select :group_role_id, @group.group_roles, :id, :name, { selected: @group.default_role&.id }, aria: { label: GroupRole.model_name.human } %>
      <%= form.submit t("group_memberships.add"), class: "btn btn-primary" %>
    <% end %>
  <% end %>

  <% if @memberships.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th><%= Person.human_attribute_name(:name) %></th>
            <th><%= GroupRole.model_name.human %></th>
            <th><%= Person.human_attribute_name(:phone) %></th>
            <th><%= Person.human_attribute_name(:email) %></th>
            <% if can?(:manage_groups) %><th></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <% person = membership.person %>
            <tr>
              <td><%= link_to "#{person.last_name} #{person.first_name}", person %></td>
              <td>
                <% if can?(:manage_groups) %>
                  <%= form_with model: [ @group, membership ], class: "inline-form compact" do |form| %>
                    <%= form.collection_select :group_role_id, @group.group_roles, :id, :name, {},
                          data: { controller: "auto-submit", action: "change->auto-submit#submit" }, aria: { label: GroupRole.model_name.human } %>
                  <% end %>
                <% else %>
                  <%= membership.group_role.name %>
                <% end %>
              </td>
              <td><%= person.effective_phone %></td>
              <td><%= mail_to person.email if person.email.present? %></td>
              <% if can?(:manage_groups) %>
                <td class="actions-cell">
                  <%= button_to t("group_memberships.remove"), group_group_membership_path(@group, membership), method: :delete,
                        class: "link-button danger", form: { data: { turbo_confirm: t("confirm") } } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="muted"><%= t("groups.no_members") %></p>
  <% end %>
</section>
