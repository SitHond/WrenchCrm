<% content_for :title, t("privacy_policy.title") %>
<% operator = @shop.legal_name.presence || @shop.display_name %>
<h1><%= t("privacy_policy.title") %></h1>
<p class="muted"><%= operator %><%= ", ИНН #{@shop.inn}" if @shop.inn.present? %><%= ", ОГРН #{@shop.ogrn}" if @shop.ogrn.present? %><%= ", #{@shop.address}" if @shop.address.present? %></p>
<% if @shop.privacy_policy_text.present? %>
  <%= simple_format(@shop.privacy_policy_text) %>
<% else %>
  <%= simple_format(t("privacy_policy.default_text", locale: :ru,
        operator: operator, address: @shop.address.presence || "—",
        contacts: [ @shop.phone, @shop.email ].compact_blank.join(", ").presence || "—",
        updated: l(@shop.updated_at.to_date, format: :long, locale: :ru))) %>
<% end %>
