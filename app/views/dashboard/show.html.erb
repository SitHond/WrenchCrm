<%= page_header t("nav.dashboard") do %>
  <%= link_to t("work_orders.new"), new_work_order_path, class: "btn btn-primary" if can?(:manage_orders) %>
  <%= link_to t("clients.new"), new_client_path(with_vehicle: 1), class: "btn" if can?(:manage_clients) %>
<% end %>

<div class="stats">
  <% if @due_reminders_count.positive? %>
    <%= link_to service_reminders_path, class: "stat" do %>
      <span class="stat-value"><%= @due_reminders_count %></span><span class="stat-label"><%= t("dashboard.reminders") %></span>
    <% end %>
  <% end %>
  <% if @estimates_count.positive? %>
    <%= link_to work_orders_path(status: "estimate"), class: "stat" do %>
      <span class="stat-value"><%= @estimates_count %></span><span class="stat-label"><%= t("dashboard.estimates") %></span>
    <% end %>
  <% end %>
  <% WorkOrder::OPEN_STATUSES.each do |status| %>
    <%= link_to work_orders_path(status: status), class: "stat" do %>
      <span class="stat-value"><%= @status_counts[status].to_i %></span>
      <span class="stat-label"><%= enum_label(WorkOrder, :status, status) %></span>
    <% end %>
  <% end %>
</div>

<div class="stats">
  <div class="stat">
    <span class="stat-value"><%= money(@revenue_today) %></span><span class="stat-label"><%= t("dashboard.revenue_today") %></span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= money(@revenue_month) %></span><span class="stat-label"><%= t("dashboard.revenue_month") %></span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= @orders_month %></span><span class="stat-label"><%= t("dashboard.orders_month") %></span>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <h2><%= link_to t("dashboard.my_tasks"), tasks_path %></h2>
    <%= render "tasks/list", tasks: @my_tasks, show_subject: true %>
    <%= render "tasks/form_inline" %>
  </section>

  <section class="card">
    <h2><%= link_to t("dashboard.appointments_today"), appointments_path %></h2>
    <% if @appointments_today.any? %>
      <ul class="list">
        <% @appointments_today.each do |appointment| %>
          <li>
            <%= link_to appointment_time_range(appointment), appointment %>
            <span><%= appointment.vehicle.label %></span>
            <span class="muted"><%= appointment.bay&.name %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted"><%= t("dashboard.no_appointments") %></p>
    <% end %>
  </section>

  <section class="card">
    <h2><%= t("dashboard.ready") %></h2>
    <%= render "work_orders/compact_list", work_orders: @ready_orders, empty: t("dashboard.no_ready") %>
  </section>

  <section class="card">
    <h2><%= t("dashboard.due") %></h2>
    <%= render "work_orders/compact_list", work_orders: @due_orders, empty: t("dashboard.no_due") %>
  </section>

  <section class="card">
    <h2><%= t("dashboard.low_stock") %></h2>
    <% if @low_stock.any? %>
      <ul class="list">
        <% @low_stock.each do |part| %>
          <li><%= part.name %> <span class="muted"><%= quantity_with_unit(part.quantity, part.unit) %></span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted"><%= t("dashboard.stock_ok") %></p>
    <% end %>
  </section>
</div>
