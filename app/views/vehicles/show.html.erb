<%= page_header @vehicle.title do %>
  <% if can?(:manage_orders) %>
    <%= link_to t("work_orders.new"), new_work_order_path(vehicle_id: @vehicle.id), class: "btn btn-primary" %>
    <%= link_to t("appointments.book"), new_appointment_path(vehicle_id: @vehicle.id), class: "btn" %>
  <% end %>
  <%= link_to t("edit"), edit_vehicle_path(@vehicle), class: "btn" if can?(:manage_clients) %>
  <%= button_to t("delete"), @vehicle, method: :delete, class: "btn btn-danger",
        form: { data: { turbo_confirm: t("confirm") } } if can?(:delete_records) %>
<% end %>

<p class="subtitle">
  <% if @vehicle.plate_number %><span class="plate"><%= @vehicle.plate_number %></span> · <% end %>
  <%= link_to @vehicle.client.display_name, @vehicle.client %>, <%= @vehicle.client.phone %>
</p>

<div class="grid-2">
  <section class="card">
    <h2><%= t("vehicles.sections.details") %></h2>
    <dl class="details">
      <%= detail_row Vehicle.human_attribute_name(:vin), tag.span(@vehicle.vin, class: "mono") if @vehicle.vin %>
      <%= detail_row Vehicle.human_attribute_name(:year), @vehicle.year %>
      <%= detail_row Vehicle.human_attribute_name(:color), @vehicle.color %>
      <%= detail_row Vehicle.human_attribute_name(:engine), @vehicle.engine %>
      <%= detail_row Vehicle.human_attribute_name(:engine_number), (tag.span(@vehicle.engine_number, class: "mono") if @vehicle.engine_number) %>
      <%= detail_row Vehicle.human_attribute_name(:body_number), (tag.span(@vehicle.body_number, class: "mono") if @vehicle.body_number) %>
      <%= detail_row Vehicle.human_attribute_name(:mileage), (t("vehicles.km", count: number_with_delimiter(@vehicle.mileage)) if @vehicle.mileage) %>
    </dl>
  </section>

  <% if @appointments.any? %>
    <section class="card">
      <h2><%= t("appointments.upcoming") %></h2>
      <ul class="list">
        <% @appointments.each do |appointment| %>
          <li><%= link_to l(appointment.starts_at, format: :short), appointment %> <span class="muted"><%= appointment.bay&.name %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @warranties.any? %>
    <section class="card">
      <h2><%= t("warranty.active_title") %></h2>
      <ul class="list">
        <% @warranties.each do |line| %>
          <li>
            <%= line.name %>
            <span class="muted small"><%= link_to "№ #{line.work_order.number}", line.work_order %> · <%= warranty_text(line) %>
              <% if line.warranty_until %> · <%= t("warranty.until", date: l(line.warranty_until)) %><% end %>
              <% if line.warranty_until_km %> · <%= t("warranty.until_km", km: number_with_delimiter(line.warranty_until_km)) %><% end %></span>
          </li>
        <% end %>
      </ul>
      <% if can?(:manage_orders) %>
        <%= link_to t("warranty.new_claim"), new_work_order_path(vehicle_id: @vehicle.id, warranty_of_id: @warranties.first.work_order_id), class: "btn" %>
      <% end %>
    </section>
  <% end %>

  <section class="card">
    <h2><%= t("reminders.vehicle_title") %></h2>
    <% if @reminders.any? %>
      <div class="reminders compact"><%= render partial: "service_reminders/reminder", collection: @reminders %></div>
    <% else %>
      <p class="muted"><%= t("reminders.none_for_vehicle") %></p>
    <% end %>
    <% if can?(:manage_clients) %>
      <%= form_with model: ServiceReminder.new, class: "inline-form" do |form| %>
        <%= form.hidden_field :vehicle_id, value: @vehicle.id %>
        <%= form.text_field :title, required: true, placeholder: t("reminders.title_placeholder"), aria: { label: ServiceReminder.human_attribute_name(:title) } %>
        <%= form.date_field :due_on, aria: { label: ServiceReminder.human_attribute_name(:due_on) } %>
        <%= form.number_field :due_mileage, min: 1, step: 1, class: "price", placeholder: t("reminders.km_placeholder"), aria: { label: ServiceReminder.human_attribute_name(:due_mileage) } %>
        <%= form.submit t("add"), class: "btn" %>
      <% end %>
      <% if (estimate = @vehicle.estimated_mileage) %>
        <p class="hint"><%= t("reminders.vehicle_estimate", km: number_with_delimiter(estimate), per_year: number_with_delimiter((@vehicle.km_per_day * 365).round(-2))) %></p>
      <% end %>
    <% end %>
  </section>

  <%= render "tasks/section", subject: @vehicle %>
  <%= render "notes/section", notable: @vehicle, notes: @notes %>
</div>

<section class="card">
  <h2><%= t("vehicles.history") %></h2>
  <% if @work_orders.any? %>
    <% @work_orders.each do |order| %>
      <div class="history-item">
        <div class="history-head">
          <%= link_to "№ #{order.number}", order %>
          <span class="muted"><%= l(order.created_at.to_date) %></span>
          <% if order.mileage %><span class="muted"><%= t("vehicles.km", count: number_with_delimiter(order.mileage)) %></span><% end %>
          <%= status_badge(order) %>
          <span class="spacer"></span>
          <strong><%= money(order.total) %></strong>
        </div>
        <% if order.labor_lines.any? || order.part_lines.any? %>
          <p class="muted small"><%= (order.labor_lines.map(&:name) + order.part_lines.map(&:name)).join(", ") %></p>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="muted"><%= t("vehicles.no_history") %></p>
  <% end %>
</section>
